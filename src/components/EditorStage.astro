---
import ChevronLeft from "@/assets/svg/chevron-left.svg"
import Download from "@/assets/svg/download.svg"
import Undo from "@/assets/svg/undo.svg"
import Redo from "@/assets/svg/redo.svg"
import Play from "@/assets/svg/play.svg"
import Pause from "@/assets/svg/pause.svg"
import Fullscreen from "@/assets/svg/fullscreen.svg"
import SubtitleStyleBar from "@/components/SubtitleStyleBar.astro"
import EditorSidebar from "@/components/EditorSidebar.astro"
import Timeline from "@/components/Timeline.astro"
import { useTranslations } from "@/i18n/ui"

const t = useTranslations(Astro.currentLocale)
---

<section id="stage-editor" class="stage-editor" data-mobile-tab="subtitles" hidden>
  <header class="editor-top">
    <button id="back-btn" class="btn-ghost" type="button">
      <ChevronLeft />
      <span>{t.editor.back}</span>
    </button>
    <div class="editor-history">
      <button
        id="undo-btn"
        class="btn-icon"
        type="button"
        aria-label={t.editor.undo}
        title={t.editor.undoTitle}
        disabled
      >
        <Undo />
      </button>
      <button
        id="redo-btn"
        class="btn-icon"
        type="button"
        aria-label={t.editor.redo}
        title={t.editor.redoTitle}
        disabled
      >
        <Redo />
      </button>
    </div>
    <div id="video-meta" class="video-meta"></div>
    <span id="generation-time" class="generation-time" hidden></span>
    <div class="editor-actions">
      <button id="download-srt-btn" class="btn-soft" type="button" disabled>
        <Download />
        <span>{t.editor.downloadSrt}</span>
      </button>
      <div class="export-options" aria-label={t.editor.videoExportOptions}>
        <label class="export-field" for="export-format">
          <span>{t.editor.videoFormat}</span>
          <select id="export-format" name="export-format">
            <option value="mp4">{t.editor.formatMp4}</option>
            <option value="webm">{t.editor.formatWebm}</option>
          </select>
        </label>
        <label class="export-field" for="export-quality">
          <span>{t.editor.videoQuality}</span>
          <select id="export-quality" name="export-quality">
            <option value="optimized">{t.editor.qualityOptimized}</option>
            <option value="high">{t.editor.qualityHigh}</option>
            <option value="lossless">{t.editor.qualityLossless}</option>
          </select>
        </label>
      </div>
      <button
        id="download-video-btn"
        class="btn-soft btn-soft--primary"
        type="button"
        disabled
      >
        <Download />
        <span>{t.editor.downloadVideo}</span>
      </button>
    </div>
  </header>

  <div class="editor-body">
    <!-- Main column -->
    <div class="editor-main">
      <div class="video-preview" id="video-preview">
        <video id="video" playsinline></video>
        <div id="caption-guides" class="caption-guides" hidden aria-hidden="true">
          <span class="caption-guide caption-guide-v"></span>
          <span class="caption-guide caption-guide-h caption-guide-h--top"></span>
          <span class="caption-guide caption-guide-h caption-guide-h--middle"
          ></span>
          <span class="caption-guide caption-guide-h caption-guide-h--bottom"
          ></span>
        </div>
        <div
          id="caption-overlay"
          class="caption-layer"
          data-drag-label={t.style.dragAria}
        >
        </div>
      </div>

      <!-- Quick mobile player controls -->
      <div class="mobile-player-bar">
        <button id="mobile-play-btn" class="mobile-play-btn" type="button" aria-label={t.timeline.playPause}>
          <Play class="ic-play" />
          <Pause class="ic-pause" />
        </button>
        <span id="mobile-clock" class="mobile-clock">0:00.00 / 0:00.00</span>
        <div class="mobile-player-tools">
          <button id="mobile-fs-btn" class="mobile-icon-btn" type="button" aria-label={t.timeline.fullscreen}>
            <Fullscreen class="ic-fs" />
          </button>
        </div>
      </div>

      <!-- Mobile CapCut / OpenCap studio navigation bar -->
      <nav class="mobile-editor-tabs" id="mobile-editor-tabs" aria-label="Studio mode">
        <button class="mobile-tab-btn is-active" type="button" data-tab="subtitles">
          <span class="tab-icon">💬</span>
          <span>{t.editor.tabSubtitles}</span>
        </button>
        <button class="mobile-tab-btn" type="button" data-tab="style">
          <span class="tab-icon">🎨</span>
          <span>{t.editor.tabStyle}</span>
        </button>
        <button class="mobile-tab-btn" type="button" data-tab="timeline">
          <span class="tab-icon">⏱️</span>
          <span>{t.editor.tabTimeline}</span>
        </button>
      </nav>

      <!-- Style panel -->
      <div class="style-bar-container" data-panel="style">
        <SubtitleStyleBar />
      </div>
    </div>

    <!-- Sidebar segments panel -->
    <div class="sidebar-container" data-panel="subtitles">
      <EditorSidebar />
    </div>
  </div>

  <!-- Timeline bottom panel -->
  <div class="timeline-container" data-panel="timeline">
    <Timeline />
  </div>
</section>
