{
  "appId": "app.subvid.desktop",
  "productName": "Subvid",
  "copyright": "Copyright © 2026 Subvid",
  "directories": {
    "output": "dist-electron",
    "buildResources": "resources"
  },
  "files": [
    "dist/**/*",
    "electron/**/*",
    "resources/**/*",
    "package.json"
  ],
  "extraMetadata": {
    "main": "electron/main.cjs"
  },
  "linux": {
    "target": [
      {
        "target": "AppImage",
        "arch": ["x64"]
      },
      {
        "target": "deb",
        "arch": ["x64"]
      },
      {
        "target": "tar.gz",
        "arch": ["x64"]
      }
    ],
    "category": "AudioVideo",
    "icon": "resources/icon.png",
    "synopsis": "Automated subtitling and video translation application",
    "description": "AI-powered subtitle generator and video subtitle translator running 100% locally."
  },
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      },
      {
        "target": "portable",
        "arch": ["x64"]
      }
    ],
    "icon": "resources/icon.ico"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": "always",
    "createStartMenuShortcut": true,
    "shortcutName": "Subvid"
  },
  "mac": {
    "target": [
      {
        "target": "dmg",
        "arch": ["x64", "arm64"]
      },
      {
        "target": "zip",
        "arch": ["x64", "arm64"]
      }
    ],
    "category": "public.app-category.video",
    "icon": "resources/icon.icns",
    "hardenedRuntime": false,
    "gatekeeperAssess": false
  }
}
